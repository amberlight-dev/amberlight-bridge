      }
    },
    "Atmet langsam. Reagiert er auf Sessions, wird er schneller, solange gearbeitet wird, und leuchtet kurz auf, wenn etwas fertig ist." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathes slowly. When it reacts to sessions, it speeds up while work is in progress and flashes briefly when something is done."
          }
        }
      }
    },
